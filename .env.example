# Server-side only. Never expose to the browser.
# Set one of these. If both are set, Anthropic is used unless LLM_PROVIDER=openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# LLM_PROVIDER=anthropic|openai
# REASONING_EFFORT=low|medium|high|off   (default low; only sent to models that support it, e.g. gpt-oss, gpt-5, o-series, Claude Sonnet/Opus 4.6+)
# SYSTEM1_MODEL=claude-haiku-4-5   (default for OpenAI: gpt-4.1-mini)
# Any OpenAI-compatible API, e.g. Cerebras: put its key in OPENAI_API_KEY, set LLM_PROVIDER=openai,
# and set SYSTEM1_MODEL to one of its model ids (it needs tool calling + streaming).
# OPENAI_BASE_URL=https://api.cerebras.ai/v1
PORT=8787
# Optional local fast path (fastpath/server.py): simple commands skip the cloud model.
# FASTPATH_URL=http://127.0.0.1:8788
# FASTPATH_TIMEOUT_MS=1000
