# Server-side only. Never expose to the browser.
# The app's Model settings (gear next to the status pill) override everything here, per browser.
# Set one of these. If both are set, Anthropic is used unless LLM_PROVIDER=openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# LLM_PROVIDER=anthropic|openai
# SYSTEM1_MAX_TURNS=6   (OpenAI-compatible only: max model requests per multi-step command; 1 = no follow-ups, use on tight rate limits)
# REASONING_EFFORT=low|medium|high|off   (default low; only sent to models that support it, e.g. gpt-oss, gpt-5, o-series, Claude Sonnet/Opus 4.6+)
# OBJECT_MODE=enum|text   (default enum: add_object lists the ~190 curated pictures; text: the model writes a plain noun, mapped on the server to ~1,600 pictures (the whole icon set) or drawn as a labelled box; ~1.8k fewer prompt characters)
# TOOL_ROUTER=auto|all   (default auto: each request carries the 8 core tools plus only the extra tool groups a keyword/scene filter picks for the command, ~8k characters instead of ~26k; all: every tool and the full prompt)
# SYSTEM1_MODEL=claude-haiku-4-5   (default for OpenAI: gpt-4.1-mini)
# Any OpenAI-compatible API, e.g. Cerebras: put its key in OPENAI_API_KEY, set LLM_PROVIDER=openai,
# and set SYSTEM1_MODEL to one of its model ids (it needs tool calling + streaming).
# OPENAI_BASE_URL=https://api.cerebras.ai/v1
PORT=8787
# Optional local fast path (fastpath/server.py): simple commands skip the cloud model.
# FASTPATH_URL=http://127.0.0.1:8788
# FASTPATH_TIMEOUT_MS=1500
# Speech-to-text for the mic button (the app's Settings can switch it per browser):
# moonshine = local stt/server.py sidecar (default); deepgram / assemblyai = cloud, relayed by this server;
# browser = the browser's built-in Web Speech API (no key; Chrome/Edge/Safari, not Firefox).
# STT_PROVIDER=moonshine|deepgram|assemblyai|browser
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# DEEPGRAM_MODEL=nova-3
# ASSEMBLYAI_MODEL=universal-streaming-english
